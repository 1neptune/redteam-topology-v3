# Copy of .env.example. Keep real secrets out of version control.
# Notes stay in English: dotenvy rejects backslashes in values, so paths use forward slashes.

# Data directory: SQLite, uploaded files and the master key live here.
# Keep it outside the source tree so a cleanup cannot delete your data.
ATLAS_DATA_DIR=D:/atlas-data

# HTTP port
ATLAS_PORT=8080

# JWT signing secret (>= 16 chars). Empty means a random one per start,
# which logs everybody out on restart.
ATLAS_JWT_SECRET=K7mQ2pLw9RvTzXc4NbYh6JfD3sA8eGu1

# Topology encryption passphrase. Empty generates data/secret.key.
# Changing it later makes existing topologies undecryptable.
ATLAS_SECRET=atlas-local-master-key-2026

# Initial admin: only used when the user table is empty.
# Password must be at least 8 chars with upper and lower case.
ATLAS_ADMIN_USER=admin
ATLAS_ADMIN_PASSWORD=Atlas#2026_Adm1n
# Build mirrors. Leave empty to use the official sources.
# On a machine in mainland China, set these to cut the apt stage from ~130s to ~15s:
#   APT_MIRROR=mirrors.aliyun.com
#   NPM_REGISTRY=https://registry.npmmirror.com
#   CARGO_MIRROR=sparse+https://mirrors.ustc.edu.cn/crates.io-index/
APT_MIRROR=
NPM_REGISTRY=
CARGO_MIRROR=